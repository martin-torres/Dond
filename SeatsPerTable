    "multi_device_join": {
      "flow": [
        "Guest #1 (host) selects a table and turns the 'Waiting for more guests?' toggle ON.",
        "Each new guest scans the same table QR code.",
        "App detects an existing joinable table session and prompts the new guest to choose a seat on a mini seating map for that table.",
        "After choosing a seat, the guest either types a display name (e.g., 'Son', 'Aunt', 'Friend') or uses their default profile name.",
        "All orders placed from that device are internally tagged with {tableId, seatId, optionalDisplayName}."
